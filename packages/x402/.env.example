# Perault x402 facilitator. Copy to .env (never commit .env).

# Relayer key: pays gas for settlements, holds no customer funds. Use a fresh key and fund it
# with a little tQDAY only. Generate one with: cast wallet new
FACILITATOR_PRIVATE_KEY=

# Required by merchants as `Authorization: Bearer <key>` on POST /settle. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
FACILITATOR_API_KEY=

PORT=4020
RPC_URL=https://rpc-test.qday.info
CHAIN_ID=44005

# Optional overrides (local anvil or fork). Defaults: the official Aevum testnet deployment.
# VAULT=0x...
# TOKEN=0x...
# NETWORK_NAME=aevum-testnet
