{
  "name": "@perault/mcp",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "description": "MCP server that lets Claude (or any MCP agent) pay x402 endpoints through a Perault session: capped, allowlisted, revocable.",
  "bin": { "perault-mcp": "./src/main.ts" },
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/main.ts",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "@perault/sdk": "workspace:*",
    "@perault/x402": "workspace:*",
    "tsx": "4.23.15",
    "viem": "2.57.12",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "5.9.3"
  }
}
